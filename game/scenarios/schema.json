{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "por-scenario",
  "title": "Gold Box Plus scenario (W11): a party placed in a game situation",
  "description": "Built into a genuine saved game by game/plus/cheats/scenario.js and loaded with the game's own Load Saved Game. Members are made by the character-creation, training, shop and memorize rules (game/areas/testparty.js); values outside the game's limits need \"cheat\": true.",
  "type": "object",
  "required": ["dataset", "block", "x", "y", "party"],
  "properties": {
    "name": { "type": "string" },
    "title": { "type": "string" },
    "note": { "type": "string" },
    "slot": { "type": "string", "pattern": "^[A-Ja-j]$", "default": "J", "description": "save slot written (other CHRDAT<slot>* files are erased)" },
    "dataset": { "type": "integer", "minimum": 1, "maximum": 8 },
    "block": { "type": "integer", "minimum": 0, "description": "ECL<dataset>.DAX record = the event script resumed" },
    "map": { "type": "integer", "description": "GEO<dataset>.DAX record (Mem[49C5]); default = block" },
    "x": { "type": "integer", "minimum": 0, "maximum": 15 },
    "y": { "type": "integer", "minimum": 0, "maximum": 15 },
    "facing": { "enum": ["N", "E", "S", "W"], "default": "N" },
    "travelMode": { "type": "integer", "description": "default: 2/3/4 for blocks 19h/1Ah/1Bh, else 1 (3D)" },
    "clock": { "type": "object", "properties": { "round": { "type": "integer" }, "minute": { "type": "integer" }, "hour": { "type": "integer" }, "day": { "type": "integer" }, "month": { "type": "integer" }, "year": { "type": "integer" } } },
    "flags": { "type": "object", "description": "ECL memory words: hex address (4900..4CFF, 6B00..6EFF, 9700..98FF) -> value; see decode/ecl/QUESTS.md, FLAGMAP.md",
      "patternProperties": { "^(0x)?[0-9A-Fa-f]{4}$": { "type": ["integer", "string"] } }, "additionalProperties": false },
    "items": { "type": "array", "description": "extra Phlan-shop wares: { to: member index, type: item type, readied }",
      "items": { "type": "object", "required": ["type"], "properties": { "to": { "type": "integer" }, "type": { "type": "integer" }, "readied": { "type": "boolean" } } } },
    "cheat": { "type": "boolean", "default": false },
    "party": { "type": "array", "minItems": 1, "maxItems": 6, "items": {
      "type": "object", "required": ["name", "race"],
      "properties": {
        "name": { "type": "string", "maxLength": 15 },
        "race": { "type": ["string", "integer"], "description": "race name as the game spells it, or its id" },
        "class": { "type": ["string", "integer"], "description": "class name (\"Fighter/Magic-User\") or id" },
        "classes": { "type": "array", "items": { "type": "string" } },
        "level": { "type": "integer", "minimum": 1 },
        "levels": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "description": "one per base class, in the game's class order" },
        "gender": { "type": ["string", "integer"] },
        "alignment": { "type": ["string", "integer"] },
        "stats": { "type": "object", "properties": { "str": {}, "exc": {}, "int": {}, "wis": {}, "dex": {}, "con": {}, "cha": {} }, "description": "number or \"max\" (default: the race/class maximum)" },
        "hp": { "type": "integer", "description": "current HP (above max only with cheat)" },
        "gold": { "type": "integer", "minimum": 0 },
        "items": { "type": "array", "description": "Phlan-shop item types: number or { type, readied }; default = the test party's gear for the class" },
        "learn": { "type": "array", "items": { "type": "string" }, "description": "magic-user spells to learn at each new level, in order of preference" },
        "spells": { "type": "array", "items": { "type": "string" }, "description": "spells to memorise" },
        "pic": { "type": "array", "items": { "type": "integer" }, "minItems": 4, "maxItems": 4 },
        "cheat": { "type": "boolean" }
      } } }
  }
}
